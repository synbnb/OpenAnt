# Local-only scratch and generated artifacts (not part of the codebase)
*knowledge-graph.*
/bughunt-repros/

# Local OpenHarmony dynamic-test toolchain and generated signing cache.
# The project-local toolchain is physically kept under runtime/openharmony so a
# copied delivery directory is self-contained. The multi-gigabyte,
# platform-specific payload is ignored by the source Git checkout; release
# packaging must include this directory (or an equivalent platform bundle).
libs/vulnfounder-core/utilities/dynamic_tester/toolchains/
assets/toolchains/
# The platform tool payload is large and platform-specific, so it is excluded
# from ordinary source commits while portable documentation and manifests stay
# tracked.
runtime/openharmony/*
!runtime/openharmony/
!runtime/openharmony/README.md
!runtime/openharmony/manifest.example.json
!runtime/openharmony/*/
runtime/openharmony/*/*
!runtime/openharmony/*/manifest.json
config/hap_cert/*
!config/hap_cert/README.md
libs/vulnfounder-core/utilities/dynamic_tester/fixtures/hap_smoke_app/.hvigor-user-home/
libs/vulnfounder-core/utilities/dynamic_tester/fixtures/hap_smoke_app/signing/*.p12

# Local OpenHarmony repositories, evaluation checkouts and scan outputs.
# These can be multi-gigabyte or contain device-specific/generated data and
# should remain local rather than being uploaded with the application source.
.hvigor/
/source_code_base/
/libs/vulnfounder-core/utilities/openharmony_dynamic/agent/contracts/generated/device_facts_*.json
/result/*
!/result/.gitkeep
/debug_outputs/
/repro_outputs/
/test_records/
/exposure_surface_*/
/evaluation_dataset/vulnerability/vulnerable_source_code_base/
/log.txt
**/.DS_Store
libs/vulnfounder-core/utilities/dynamic_tester/fixtures/hap_smoke_app/.hvigor/
libs/vulnfounder-core/utilities/dynamic_tester/fixtures/hap_smoke_app/signing/
