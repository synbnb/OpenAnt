{
  "app": {
    "signingConfigs": [
      {
        "name": "default",
        "type": "OpenHarmony",
        "material": {
          "certpath": "./signing/app-cert.pem",
          "storePassword": "00000000000000000000000000000000",
          "keyAlias": "debugKey",
          "keyPassword": "00000000000000000000000000000000",
          "profile": "./signing/debug-profile.p7b",
          "signAlg": "SHA256withECDSA",
          "storeFile": "./signing/debug.p12"
        }
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        "compileSdkVersion": 23,
        "compatibleSdkVersion": 23,
        "targetSdkVersion": 23,
        "runtimeOS": "OpenHarmony"
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./Entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}
